{
  "name": "PointTransaction",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "manual",
        "mission"
      ],
      "default": "manual"
    },
    "mission_id": {
      "type": "string"
    },
    "mission_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "awarded_by_name": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "Di\u00e1ria",
        "Semanal",
        "Mensal"
      ]
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "sector",
    "points"
  ]
}