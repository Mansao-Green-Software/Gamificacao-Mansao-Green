{
  "name": "PointTransaction",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "manual",
        "mission"
      ],
      "default": "manual"
    },
    "mission_id": {
      "type": "string"
    },
    "mission_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "awarded_by_name": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "description": "Data real da transa\u00e7\u00e3o (ISO string). Usar este campo para filtros de per\u00edodo quando dispon\u00edvel."
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "sector",
    "points"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}