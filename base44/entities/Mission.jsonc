      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "sector": {
      "type": "string",
      "enum": [
        "Social Media",
        "Audiovisual",
        "Tr\u00e1fego",
        "L\u00edder de Projeto",
        "Tipster",
        "Suporte",
        "Conting\u00eancia",
        "Comercial",
        "Financeiro",
        "Affiliates",
        "Administrativo",
        "Ger\u00eancia",
        "Sa\u00fade e Bem Estar",
        "Servi\u00e7os Gerais",
        "TV Green",
        "Feira FC",
        "TI",
        "IA/Automa\u00e7\u00e3o",
        "Supervisor",
        "Todos"
      ]
    },
    "sub_sector": {
      "type": "string",
      "description": "Sub-setor opcional para categoriza\u00e7\u00e3o mais granular"
    },
    "category": {
      "type": "string",
      "enum": [
        "Performance & Resultados",
        "Disciplina & Organiza\u00e7\u00e3o",
