{
  "name": "Reward",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "points_cost": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "stock": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "category": {
      "type": "string",
      "enum": [
        "Experi\u00eancia",
        "Produto",
        "Benef\u00edcio",
        "Vale-presente",
        "Outros"
      ],
      "default": "Outros"
    }
  },
  "required": [
    "title",
    "points_cost"
  ]
}