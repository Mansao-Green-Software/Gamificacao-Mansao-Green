{
  "name": "MissionRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "mission_title": {
      "type": "string"
    },
    "mission_points": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado",
        "cancelado"
      ],
      "default": "pendente"
    },
    "notes": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "cancellation_note": {
      "type": "string",
      "description": "Justificativa do cancelamento ap\u00f3s aprova\u00e7\u00e3o"
    },
    "cancelled_by_name": {
      "type": "string",
      "description": "Nome de quem cancelou a pontua\u00e7\u00e3o aprovada"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "mission_id",
    "mission_title",
    "mission_points"
  ],
  "rls": {
    "create": {},
    "update": {}
  }
}